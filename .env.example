# Environment FALLBACK for the Squadron LocalDev plugin.
#
# The preferred way to supply credentials is via Squadron secrets wired into the
# plugin's settings (bedrock_api_key, github_token) — see the README. These
# environment variables are only used when the corresponding setting is omitted.
#
# Copy to .env and fill in, or export these in your shell. NEVER commit a real
# .env — it is gitignored.

# --- GitHub access (fallback for the github_token setting) ---
# A token with repo scope. Required to clone private repos, push branches, and
# open pull requests. Without it, the plugin operates on public repos read-only.
GITHUB_TOKEN=

# --- AWS Bedrock (fallback for the bedrock_api_key setting) ---
# Option A: a Bedrock API key (bearer token) — the "API connection method".
# AWS_BEARER_TOKEN_BEDROCK=

# Option B: standard AWS credentials (SigV4) via keys, a profile, SSO, or a role.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=your-profile-name
