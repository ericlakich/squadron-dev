# Example environment for the Squadron LocalDev plugin.
# Copy to .env and fill in, or export these in your shell before running Squadron.
# NEVER commit a real .env file — it is gitignored.

# --- GitHub access (read from the environment, never from HCL settings) ---
# A token with repo scope. Required to clone private repos, push branches, and
# open pull requests. Without it, the plugin can still operate on public repos
# read-only (QA / review without posting).
GITHUB_TOKEN=

# --- AWS Bedrock credentials (resolved by the standard AWS credential chain) ---
# Use ONE of: static keys, a named profile, SSO, or an attached IAM role.
# The plugin never reads these from HCL settings.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=your-profile-name
