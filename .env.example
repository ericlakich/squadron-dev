# Environment FALLBACK for the Squadron LocalDev plugin.
#
# The preferred way to supply credentials is via Squadron secrets wired into the
# plugin's settings (bedrock_api_key, github_token) — see the README. These
# environment variables are only used when the corresponding setting is omitted.
#
# Copy to .env and fill in, or export these in your shell. NEVER commit a real
# .env — it is gitignored.

# --- GitHub access (fallback for the github_token setting) ---
# A token with repo scope. Required to clone private repos, push branches, and
# open pull requests. Without it, the plugin operates on public repos read-only.
GITHUB_TOKEN=

# --- Amazon Bedrock API key (fallback for the bedrock_api_key setting) ---
# Used by both providers: required for bedrock-mantle (default), and enables
# bearer-token auth for bedrock-runtime. See:
# https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_API_KEY=

# Region selects the Bedrock endpoint host for both providers.
AWS_REGION=us-east-1

# Optional: override the bedrock-mantle base URL (default is derived from region:
# https://bedrock-mantle.{region}.api.aws).
# BEDROCK_MANTLE_ENDPOINT=

# --- bedrock-runtime only: standard AWS credentials (SigV4) ---
# Used when provider = "bedrock-runtime" and no Bedrock API key is set.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=your-profile-name
